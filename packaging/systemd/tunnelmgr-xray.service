[Unit]
Description=avaTUN managed Xray proxy lines and forwards
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunnelmgr
Group=tunnelmgr
UMask=0077
ExecStart=/usr/bin/python3 /opt/tunnelmgr/tunnelmgr/xray_runtime.py run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/tunnelmgr/xray/config.json
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
