[Unit]
Description=Check avaTUN GitHub update version
After=network-online.target tunnelmgr.service
Wants=network-online.target

[Service]
Type=oneshot
User=tunnelmgr
Group=tunnelmgr
Environment=TUNNELMGR_HOME=/var/lib/tunnelmgr
ExecStart=/usr/bin/python3 /opt/tunnelmgr/scripts/github-update.py check
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tunnelmgr
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
