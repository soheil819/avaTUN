[Unit]
Description=Tunnel Manager OpenConnect VPN server %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/ocserv --foreground --config=/etc/tunnelmgr/openconnect/%i/ocserv.conf
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_SYS_CHROOT
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
DeviceAllow=/dev/net/tun rw
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/tunnelmgr/openconnect /run

[Install]
WantedBy=multi-user.target
